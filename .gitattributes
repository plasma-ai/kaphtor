# Git LFS: every PDF, every JSON Lines data file, and the JSON data files over 1 MB.
# tests/test_lfs.py fails if a PDF or a data file over 1 MB matches no rule here.
*.pdf filter=lfs diff=lfs merge=lfs -text
data/**/*.jsonl filter=lfs diff=lfs merge=lfs -text
data/linear-a/corpus.json filter=lfs diff=lfs merge=lfs -text
data/linear-a/paradigm-b/snapshot/corpus.json filter=lfs diff=lfs merge=lfs -text
data/semitic-roots/semitic_roots.json filter=lfs diff=lfs merge=lfs -text
data/share-alike/egyptian/egyptian_documents.index.json filter=lfs diff=lfs merge=lfs -text

# Fonts and NumPy arrays are binary.
*.npy binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
